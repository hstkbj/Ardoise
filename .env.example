APP_NAME=Ardoise
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base centrale (écoles, abonnements, codes parents)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ardoise_central
# DB_USERNAME=root
# DB_PASSWORD=

# Bases des écoles : une par école (tenant_{code}). sqlite → database/tenants/*.sqlite
TENANT_DB_CONNECTION=sqlite
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_BASE_DOMAIN=localhost
# Créer un utilisateur MySQL dédié par école (nécessite les droits CREATE USER)
TENANCY_CREATE_DB_USERS=false

# Sanctum : domaines du SPA (cookies) — sous-domaines inclus
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,*.localhost,*.localhost:8000
# localhost cookies are host-only; log in on the same host used by the SPA.
SESSION_DOMAIN=

# Console plateforme
SUPERADMIN_EMAIL=admin@ardoise.test
SUPERADMIN_PASSWORD=password

# SMS : log (développement) ou http (passerelle)
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=ARDOISE

# Abonnements : durée d'essai, délai de grâce après l'échéance (puis blocage), rappels (jours avant la fin)
TENANCY_TRIAL_DAYS=30
TENANCY_GRACE_DAYS=15
BILLING_REMINDER_DAYS=7,3,1

# FedaPay — compte de la PLATEFORME (paiement des abonnements par les écoles)
# Clés : https://app.fedapay.com (sandbox : https://sandbox.fedapay.com) → Paramètres → Clés API
# Webhook à déclarer dans FedaPay : {APP_URL}/api/v1/webhooks/fedapay
# (Les frais scolaires payés par les parents utilisent le compte FedaPay de chaque école,
#  saisi dans Administration → Paramètres → Paiement en ligne.)
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CURRENCY=XOF
FEDAPAY_COUNTRY=bj
FEDAPAY_TIMEOUT=20
FEDAPAY_WEBHOOK_TOLERANCE=300

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# File d'attente (table jobs de la base centrale) : e-mails et notifications.
# Lancer un worker : php artisan queue:work --tries=3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ardoise.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Laisser vide : l'API est servie par la même origine (/api/v1)
VITE_API_URL=
